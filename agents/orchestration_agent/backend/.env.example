# DIWO Orchestration Agent - environment template
# ===============================================
# Copy to .env and fill in. Never commit the real .env.
#
# NOTE: config.py loads backend/.env at import, so copying this file to .env is
# all that is needed - every value below takes effect on the next start. A real
# environment variable still wins over the file, so a container can override any
# of these without editing it.

# ── This backend ─────────────────────────────────────────────────────────────
DIWO_HOST=0.0.0.0
DIWO_PORT=5001

# Flask secret key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DIWO_SECRET_KEY=replace-with-a-long-random-string

# Allowed frontend origins, comma-separated. "*" (the default) allows any.
DIWO_CORS_ORIGINS=*

# Set to 0 to turn off Flask debug mode.
FLASK_DEBUG=1

# ── Specialized agents ───────────────────────────────────────────────────────
# These are the ports each agent actually starts on:
#   CUQA   agents/cuqa_agent/src/main.py                     uvicorn port 8080
#   RDP    agents/rdp_agent/app.py                           Flask   port 5000
#   SCTVA  agents/transformation_agent/.../app.py            SCTVA_PORT, 8002
CUQA_AGENT_URL=http://localhost:8080
RDP_AGENT_URL=http://localhost:5000
SCTVA_AGENT_URL=http://localhost:8002

# ── Database ─────────────────────────────────────────────────────────────────
# Two backends behind one seam (db/workflow_repository.py):
#
#   SUPABASE_URL + a key set  ->  Supabase, over PostgREST
#   otherwise                 ->  SQLite at runtime/database/diwo_audit.db
#
# BEFORE SWITCHING TO SUPABASE, run db/schema_supabase.sql once in the Supabase
# SQL editor. The service issues no DDL, so an empty project answers every read
# with "relation does not exist".
#
# Confirm which one is live:  curl http://localhost:5001/api/health
# -> {"database": "supabase"} or {"database": "sqlite"}

# "sqlite" (default) or "supabase". Anything other than "sqlite" enables the
# Supabase backend PROVIDED the two variables below are set; if they are not,
# the service says so at startup and stays on SQLite rather than failing quietly.
DATABASE_PROVIDER=supabase

# Supabase project URL. Project Settings -> API -> Project URL.
SUPABASE_URL=PASTE YOUR PROJECT URL HERE
# USE THE SERVICE ROLE KEY HERE, not the anon key.
# Project Settings -> API -> service_role.
#
# This backend writes audit, feedback and impact rows on behalf of a workflow,
# not on behalf of a signed-in user, so there is no session for row-level
# security to evaluate. Under the anon key those writes are rejected by RLS —
# and rejected as an empty result rather than an error, which is the kind of
# failure you find out about a week later from a half-empty audit trail.
#
# The service role key bypasses RLS. It must never reach the frontend, and the
# real value belongs in .env, never in this file.
SUPABASE_SERVICE_ROLE_KEY=PASTE YOUR SERVICE ROLE KEY HERE

# Read only if SUPABASE_SERVICE_ROLE_KEY is unset. Same resolution order as
# user_management/config/supabase_client.py.
# SUPABASE_KEY=
# SUPABASE_ANON_KEY=

# ── Raw Postgres DSN (optional, not used by this service) ────────────────────
# The Supabase backend talks to PostgREST over HTTPS, not to Postgres directly,
# so nothing reads these today. Kept named for a future direct-psycopg port.
# Project Settings -> Database -> Connection string. Contains your password.
# DATABASE_URL=postgresql://postgres.PROJECT_ID:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DB_POOL_MODE=session

# ── Paths (optional) ─────────────────────────────────────────────────────────
# Defaults to runtime/database/diwo_audit.db next to this file.
# DIWO_DB_PATH=/absolute/path/to/diwo_audit.db

# Where remote repositories are cloned for the git apply-and-push flow.
# Defaults to ~/DIWO/repos
# DIWO_CLONE_ROOT=/absolute/path/to/clones
