# DIWO Orchestration Agent - environment template
# ===============================================
# Copy to .env and fill in. Never commit the real .env.
#
# NOTE: config.py loads backend/.env at import, so copying this file to .env is
# all that is needed - every value below takes effect on the next start. A real
# environment variable still wins over the file, so a container can override any
# of these without editing it.

# ── This backend ─────────────────────────────────────────────────────────────
DIWO_HOST=0.0.0.0
DIWO_PORT=5001

# Flask secret key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DIWO_SECRET_KEY=replace-with-a-long-random-string

# Allowed frontend origins, comma-separated. "*" (the default) allows any.
DIWO_CORS_ORIGINS=*

# Set to 0 to turn off Flask debug mode.
FLASK_DEBUG=1

# ── Specialized agents ───────────────────────────────────────────────────────
# These are the ports each agent actually starts on:
#   CUQA   agents/cuqa_agent/src/main.py                     uvicorn port 8080
#   RDP    agents/rdp_agent/app.py                           Flask   port 5000
#   SCTVA  agents/transformation_agent/.../app.py            SCTVA_PORT, 8002
CUQA_AGENT_URL=http://localhost:8080
RDP_AGENT_URL=http://localhost:5000
SCTVA_AGENT_URL=http://localhost:8002

# ── Database ─────────────────────────────────────────────────────────────────
# Two backends behind one seam (db/workflow_repository.py):
#
#   SUPABASE_URL + a key set  ->  Supabase, over PostgREST
#   otherwise                 ->  SQLite at runtime/database/diwo_audit.db
#
# BEFORE SWITCHING TO SUPABASE, run db/schema_supabase.sql once in the Supabase
# SQL editor. The service issues no DDL, so an empty project answers every read
# with "relation does not exist".
#
# Confirm which one is live:  curl http://localhost:5001/api/health
# -> {"database": "supabase"} or {"database": "sqlite"}

# "sqlite" (default) or "supabase". Anything other than "sqlite" enables the
# Supabase backend PROVIDED the two variables below are set; if they are not,
# the service says so at startup and stays on SQLite rather than failing quietly.
DATABASE_PROVIDER=supabase

# Supabase project URL. Project Settings -> API -> Project URL.
SUPABASE_URL=PASTE YOUR PROJECT URL HERE
# USE THE SERVICE ROLE KEY HERE, not the anon key.
# Project Settings -> API -> service_role.
#
# This backend writes audit, feedback and impact rows on behalf of a workflow,
# not on behalf of a signed-in user, so there is no session for row-level
# security to evaluate. Under the anon key those writes are rejected by RLS —
# and rejected as an empty result rather than an error, which is the kind of
# failure you find out about a week later from a half-empty audit trail.
#
# The service role key bypasses RLS. It must never reach the frontend, and the
# real value belongs in .env, never in this file.
SUPABASE_SERVICE_ROLE_KEY=PASTE YOUR SERVICE ROLE KEY HERE

# Read only if SUPABASE_SERVICE_ROLE_KEY is unset. Same resolution order as
# user_management/config/supabase_client.py.
# SUPABASE_KEY=
# SUPABASE_ANON_KEY=

# ── Raw Postgres DSN (optional, not used by this service) ────────────────────
# The Supabase backend talks to PostgREST over HTTPS, not to Postgres directly,
# so nothing reads these today. Kept named for a future direct-psycopg port.
# Project Settings -> Database -> Connection string. Contains your password.
# DATABASE_URL=postgresql://postgres.PROJECT_ID:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DB_POOL_MODE=session

# ── Paths (optional) ─────────────────────────────────────────────────────────
# Defaults to runtime/database/diwo_audit.db next to this file.
# DIWO_DB_PATH=/absolute/path/to/diwo_audit.db

# Where remote repositories are cloned for the git apply-and-push flow.
# Defaults to ~/DIWO/repos
# DIWO_CLONE_ROOT=/absolute/path/to/clones

# Token git uses to clone / push for "Push to GitHub" on a HOSTED backend,
# which has no credential helper. Fine-grained PAT with Contents: Read and
# write on the target repositories (or a classic PAT with `repo`). Set it as a
# secret in Azure, never in a committed file. Without it the push falls back to
# the GitHub App installation token (when the App is installed on the repo with
# Contents: write), then to a token typed into the Results page.
# DIWO_GIT_PUSH_TOKEN=

# Launch GitHub Desktop after writing the branch. Defaults to on for Windows /
# macOS and off on Linux (containers have no desktop).
# DIWO_OPEN_GITHUB_DESKTOP=false

# ── GitHub App integration ──────────────────────────────────────────────────
# Off until GITHUB_INTEGRATION_ENABLED=true. When enabled, a missing value is
# reported at startup and the webhook answers 503 instead of guessing.
#
# Webhook URL to configure in the GitHub App:
#   https://<DIWO-BACKEND-HOST>/api/github/webhook
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=

# The private key, from GitHub App Settings -> Private keys. Set ONE of these:
#   GITHUB_PRIVATE_KEY_PEM   the PEM text itself (use this in Azure, as a
#                            Container Apps secret; "\n" escapes are accepted)
#   GITHUB_PRIVATE_KEY_PATH  a file; a relative path is resolved against this
#                            backend/ directory, not the working directory
# secrets/ and *.pem are git-ignored. Never commit the key.
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_PRIVATE_KEY_PEM=

GITHUB_INTEGRATION_ENABLED=false
# L0: every refactoring change needs explicit developer approval. The only
# level implemented.
GITHUB_AUTONOMY_LEVEL=L0

# Optional. REST API version header; defaults to 2022-11-28.
# GITHUB_API_VERSION=2022-11-28

# Background job worker. Production: run `python github_worker.py` as its own
# process. GITHUB_EMBEDDED_WORKER=true runs it inside the web process instead
# (local development / single-container demos only).
# GITHUB_EMBEDDED_WORKER=false
# GITHUB_JOB_MAX_ATTEMPTS=5
# GITHUB_JOB_LOCK_TIMEOUT_SECONDS=600
# GITHUB_WORKER_POLL_SECONDS=5

# ── GitHub PR analysis ──────────────────────────────────────────────────────
# Public URL of the React frontend; Check Runs link to
#   <DIWO_FRONTEND_URL>/?diwo_workflow=<id>
# Leave empty and Check Runs carry no link (it is never guessed).
DIWO_FRONTEND_URL=

# Largest PR snapshot (zipball) DIWO downloads, and how long CUQA may take.
# GITHUB_SNAPSHOT_MAX_MB=100
# GITHUB_CUQA_TIMEOUT_SECONDS=300

# PR snapshots are analysed through CUQA's isolated POST /api/analyze-snapshot.
# Only for a CUQA deployment that does not have it yet: true falls back to
# /api/upload-zip + /api/quality-report, which REPLACES the repository loaded
# in CUQA's shared workspace. Keep false once CUQA is updated.
# GITHUB_CUQA_ALLOW_SHARED_WORKSPACE=false

# ── Access to GitHub-linked workflows ───────────────────────────────────────
# Workflows created from a PR require a signed-in DIWO user. Tokens are
# verified locally with the Supabase JWT secret when set (Project Settings ->
# API -> JWT secret), otherwise by asking Supabase Auth.
# SUPABASE_JWT_SECRET=
# Optional comma-separated allow-list; empty = any signed-in user.
# GITHUB_WORKFLOW_ALLOWED_EMAILS=

# ── Who may APPROVE on a GitHub-linked workflow (Milestone 4) ──────────────
# Viewing needs a signed-in user; approving (smell selection, plan decisions)
# also needs a grant for the repository, from either:
#   explicit reviewers per repository ("owner/*" covers an organisation):
# GITHUB_REPO_REVIEWERS=octo-org/demo=dev@example.org|lead@example.org;octo-org/*=lead@example.org
#   or DIWO e-mail -> GitHub login, checked live: write/maintain/admin required
# GITHUB_USER_LOGINS=dev@example.org=octocat
# With neither configured for a repository, approvals are refused. Local demos
# only: GITHUB_REQUIRE_REPO_AUTHORIZATION=false
# GITHUB_REQUIRE_REPO_AUTHORIZATION=true

# Send RDP the source of the selected files AT THE PR COMMIT (read from
# GitHub), which its Move Method resolver uses. Never from CUQA's workspace.
# GITHUB_RDP_ATTACH_SOURCES=true

# ── Interactive review on GitHub ────────────────────────────────────────────
# /refactoriq PR comment commands and Check Run buttons. Needs the App to be
# subscribed to "Issue comment" and "Check run" events.
# GITHUB_COMMANDS_ENABLED=true
# How long "submit-plan" / "submit-refactoring" wait for their "confirm".
# GITHUB_CONFIRMATION_TTL_SECONDS=1800

# Run SCTVA on pull-request code after a plan is approved. OFF by default:
# SCTVA's behavioural validation EXECUTES the code it checks. Enable only when
# SCTVA runs in an isolated container (no secrets, no internal network access,
# restricted egress, CPU/memory limits).
GITHUB_PR_TRANSFORMATION_ENABLED=false

# Commit developer-ACCEPTED, validated changes to the PR branch after an
# explicit, confirmed submit. OFF by default. Needs Contents: Read and write.
# Fast-forward only; never force-pushes; refuses if the branch has moved.
GITHUB_PR_WRITEBACK_ENABLED=false
