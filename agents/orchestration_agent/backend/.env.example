# DIWO Orchestration Agent - environment template
# ===============================================
# Copy to .env and fill in. Never commit the real .env.
#
# NOTE: this backend reads the process environment directly; it does NOT
# auto-load .env, even though python-dotenv is installed - nothing calls
# load_dotenv(). Export these, or set them in your run configuration, for them
# to take effect.

# ── This backend ─────────────────────────────────────────────────────────────
DIWO_HOST=0.0.0.0
DIWO_PORT=5001

# Flask secret key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DIWO_SECRET_KEY=replace-with-a-long-random-string

# Allowed frontend origins, comma-separated. "*" (the default) allows any.
DIWO_CORS_ORIGINS=*

# Set to 0 to turn off Flask debug mode.
FLASK_DEBUG=1

# ── Specialized agents ───────────────────────────────────────────────────────
# These are the ports each agent actually starts on:
#   CUQA   agents/cuqa_agent/src/main.py                     uvicorn port 8080
#   RDP    agents/rdp_agent/app.py                           Flask   port 5000
#   SCTVA  agents/transformation_agent/.../app.py            SCTVA_PORT, 8002
CUQA_AGENT_URL=http://localhost:8080
RDP_AGENT_URL=http://localhost:5000
SCTVA_AGENT_URL=http://localhost:8002

# ── Database ─────────────────────────────────────────────────────────────────
# NOT YET WIRED UP. db/database.py still opens SQLite directly, so these are
# read by config.py and used by nothing. Setting them does not move any data.
#
# "sqlite" (default) or "supabase".
DATABASE_PROVIDER=sqlite

# Supabase: Project Settings -> Database -> Connection string.
# Session pooler  port 5432  (supports prepared statements)
# Transaction     port 6543  (does not - psycopg needs prepare_threshold=None)
# Contains your password, so put the real one in .env, never here.
DATABASE_URL=postgresql://postgres.PROJECT_ID:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# "session" or "transaction" - must match the port above.
DB_POOL_MODE=session

# ── Paths (optional) ─────────────────────────────────────────────────────────
# Defaults to runtime/database/diwo_audit.db next to this file.
# DIWO_DB_PATH=/absolute/path/to/diwo_audit.db

# Where remote repositories are cloned for the git apply-and-push flow.
# Defaults to ~/DIWO/repos
# DIWO_CLONE_ROOT=/absolute/path/to/clones
