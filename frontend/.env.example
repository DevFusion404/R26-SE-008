# RDP Agent Backend
VITE_RDP_AGENT_API_URL=http://localhost:5000

# Code Understanding Agent (CUA)
VITE_CUA_API_URL=http://localhost:5001

# Transformation Agent (Safe Transformation & Validation)
VITE_TRANSFORMATION_AGENT_API_URL=http://localhost:5002

# DIWO Agent Backend (Flask) - serves /api/cuqa/* and /api/workflows/*
VITE_API_URL=http://localhost:5001/api

# CUQA Agent (Code Understanding & Quality Assessment, FastAPI)
# Only used as a direct fallback when the DIWO backend is unreachable.
VITE_CUQA_API_URL=http://localhost:8080

# API Endpoints
VITE_RDP_GENERATE_ENDPOINT=/generate
VITE_RDP_HEALTH_ENDPOINT=/health

# Logging
VITE_LOG_LEVEL=debug
