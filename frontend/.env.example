# DIWO Frontend - environment template
# ====================================
# Copy to .env and adjust. Never commit the real .env.
#
# Ports below are the ones each agent ACTUALLY starts on, checked against each
# agent's own entry point rather than assumed:
#
#   Orchestration (DIWO backend)  :5001  agents/orchestration_agent/backend/app.py
#   RDP agent                     :5000  agents/rdp_agent/app.py
#   CUQA agent                    :8080  agents/cuqa_agent/src/main.py
#   SCTVA agent                   :8002  agents/transformation_agent/.../app.py

# ── The DIWO workflow ────────────────────────────────────────────────────────
# This is the only URL the DIWO workflow needs. Every agent hand-off goes
# through the orchestration backend:
#
#     DIWO stage -> diwoApi.js -> Orchestration -> CUQA / RDP / SCTVA
#
# Read by pages/diwo/services/diwoApi.js. Include the /api suffix.
VITE_API_URL=http://localhost:5001/api

# Read by src/config/api.config.js for the DIWO_AGENT entry.
VITE_DIWO_API_URL=http://localhost:5001/api

# ── Standalone agent demonstration pages ─────────────────────────────────────
# CUQAAgentPage / RDPAgentPage / SCTVAAgentPage talk to their agent directly,
# which is deliberate: they exist to demonstrate one agent on its own. The DIWO
# workflow never uses these URLs.

# RDP agent (Flask). Read by src/config/api.config.js -> RDP_AGENT.
VITE_RDP_AGENT_API_URL=http://localhost:5000

# SCTVA agent (Flask). Read by src/config/api.config.js -> TRANSFORMATION_AGENT.
# This was http://localhost:5002, which no agent listens on — SCTVA reads
# SCTVA_PORT and defaults to 8002.
VITE_TRANSFORMATION_AGENT_API_URL=http://localhost:8002

# CUQA agent (FastAPI). Read by pages/transform/SCTVAAgentPage.jsx to import
# sources out of the CUQA workspace.
VITE_CUQA_AGENT_API_URL=http://localhost:8080

# CUQA agent, used by pages/diwo/services/diwoApi.js for ONE thing: the
# read-only fallback that still shows the Code Smell Review stage when the
# orchestration backend itself is down.
VITE_CUQA_API_URL=http://localhost:8080

# Legacy alias, still read by src/config/api.config.js -> CUA_AGENT and as the
# second fallback in SCTVAAgentPage. It names the CUQA agent, so it must point
# at :8080 — it previously said :5001, which is the DIWO backend.
VITE_CUA_API_URL=http://localhost:8080

# ── Logging ──────────────────────────────────────────────────────────────────
# "debug" turns on API_CONFIG.GLOBAL.enableLogging.
VITE_LOG_LEVEL=debug
